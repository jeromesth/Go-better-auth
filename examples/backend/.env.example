# Copy this file to .env and adjust the values for local development.

# PostgreSQL connection string
DATABASE_URL=postgres://auth:auth@localhost:5432/authdb?sslmode=disable

# Secret used to sign session tokens – change this in any real deployment
AUTH_SECRET=dev-secret-change-in-production-min-32-chars!!

# Public base URL of this service
BASE_URL=http://localhost:8080

# Port to listen on
PORT=8080
